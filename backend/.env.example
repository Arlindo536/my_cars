# Local development settings for `python manage.py runserver`.
# Copy this file to .env and fill in your own values.
# .env is ignored by git; never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DB_NAME=my_cars
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Comma-separated list of allowed frontend origins (default: http://localhost:4200)
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# The Docker/production settings live in ../.env.example
