# Settings for `docker compose` (production / server). Copy to .env and fill in.
# .env is ignored by git; never commit real secrets.

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DB_NAME=my_cars
DB_USER=my_cars
DB_PASSWORD=change-me-too

# The public host name(s) of the site, comma-separated
ALLOWED_HOSTS=arlindo.site
CSRF_TRUSTED_ORIGINS=https://arlindo.site

# Where nginx listens on the server; the HTTPS reverse proxy forwards to it
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Secure cookies need HTTPS. Set to False only for a plain-HTTP test on localhost.
SECURE_COOKIES=True
# Enable after HTTPS works (e.g. 31536000 = one year)
SECURE_HSTS_SECONDS=0
